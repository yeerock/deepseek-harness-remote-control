{
  "name": "dsh-rc",
  "version": "0.2.9",
  "private": true,
  "description": "Reliable, single-transport remote access for the DeepSeek Harness desktop app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node packages/plugin/scripts/build.mjs",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "clean": "tsc -b tsconfig.json --clean",
    "test": "vitest run",
    "test:unit": "vitest run packages",
    "test:watch": "vitest",
    "dev:edge": "tsx apps/edge/src/main.ts",
    "dev:agent": "tsx apps/agent/src/main.ts",
    "bench": "tsx tools/bench/bench.ts",
    "bench:quick": "tsx tools/bench/bench.ts --quick",
    "e2e": "npm run build && node tools/e2e/real-dsh.mjs",
    "e2e:fast": "node tools/e2e/real-dsh.mjs --no-browser",
    "build:types": "tsc -b tsconfig.json",
    "build:bundle": "node scripts/build-edge-bundle.mjs",
    "install:macos": "sh scripts/install-macos.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/ws": "^8.18.1",
    "playwright-core": "^1.55.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeerock/deepseek-harness-remote-control.git"
  },
  "homepage": "https://github.com/yeerock/deepseek-harness-remote-control#readme",
  "bugs": {
    "url": "https://github.com/yeerock/deepseek-harness-remote-control/issues"
  },
  "author": "yeerock",
  "contributors": [
    "yeerock"
  ]
}
