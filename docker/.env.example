# Copy to .env and fill in. Never commit the real file.
DSHLINK_DOMAIN=link.example.com
DSHLINK_PUBLIC_URL=https://link.example.com

# Optional: set a fixed first-run setup code instead of reading it from the log.
# At least 16 characters. Rotate by clearing it after setup.
# DSHLINK_SETUP_CODE=

DSHLINK_LOG_LEVEL=info