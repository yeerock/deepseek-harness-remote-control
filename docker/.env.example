# Copy to .env and fill in. Never commit the real file.
DSHRC_DOMAIN=link.example.com
DSHRC_PUBLIC_URL=https://link.example.com

# Optional: set a fixed first-run setup code instead of reading it from the log.
# At least 16 characters. Rotate by clearing it after setup.
# DSHRC_SETUP_CODE=

DSHRC_LOG_LEVEL=info