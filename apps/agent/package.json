{
  "name": "@dsh-link/agent",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Link agent: tunnel client, DSH cookie bootstrap, HTTP/WebSocket proxy, reconnect.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
